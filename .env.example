# Copy to .env and edit. Never commit the real .env.

# Admin account created by "npm run seed" (AWS) and "npm run dev" (local).
# On AWS, a password shorter than 10 characters is replaced by a generated one.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Optional
# QUIBBLE_STACK=quibble          # CloudFormation stack name used by deploy / publish / seed
# LOCAL_PORT=5050                # port for "npm run dev"
# REVEAL_MS=4000                 # pause between a question's result and the next question (local)
