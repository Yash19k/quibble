# Copy to .env and edit. Never commit the real .env.

# Admin account created by "npm run seed" (AWS) and "npm run dev" (local).
# On AWS, a password shorter than 10 characters is replaced by a generated one.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Optional
# QUIBBLE_STACK=quibble          # CloudFormation stack name used by deploy / publish / seed / preflight
# LOCAL_PORT=5050                # port for "npm run dev"

# ---- Game settings for "npm run dev" (on AWS they are template parameters / environment variables) ----
# REVEAL_MS=4000                 # pause between a question's result and the next question
# LATE_GRACE_MS=1500             # answers that reached the server up to this long after the timer hit zero still count
# MAX_PLAYERS=250                # most players one game accepts
# BROADCAST_WINDOW_MS=500        # lobby lists are pushed at most once per window per game

# ---- Abuse limits. Locally every request comes from 127.0.0.1, so "npm run dev" defaults them very high ----
# REGISTER_MAX_PER_IP=100000     # sign-ups per IP per hour (AWS: 500)
# LOGIN_FAIL_MAX_PER_IP=100000   # failed logins per IP per 15 min (AWS: 200)
# LOGIN_FAIL_MAX_PER_EMAIL=1000  # failed logins per account per 15 min (AWS: 10)

# ---- Local AWS emulation for load tests ("npm run dev"; see "Capacity & scaling" in the README) ----
# LOCAL_LAMBDA_CONCURRENCY=10    # at most this many Lambda runs at once across all functions (unset = unlimited).
#                                # Extra ones fail like on AWS: HTTP 500, a WebSocket error frame, a refused
#                                # socket, or a game-timer event re-queued with 1, 2, 4 ... s backoff.
# LOCAL_DROP_DISCONNECT_PCT=0    # skip this % of $disconnect events (API Gateway only tries its best to send them)
# LOCAL_TRACK_CAPACITY=1         # measure DynamoDB capacity per partition key: GET /__local/capacity[?reset=1]
# Emulator counters (throttles, dropped disconnects, timer re-queues): GET /__local/stats[?reset=1]
